# dba-platform 配置模板 —— 复制为 .env 后填写真实值（.env 已被 gitignore，勿提交真实密码）
# 说明：config.py 里这些字段都有默认值，未设置时回退到代码默认；本文件用于显式覆盖。

# ── 环境 ──────────────────────────────────────────────
DBA_ENV=dev

# ── 存储（外部组件统一在虚拟机 192.168.200.10）─────────
# 密码改为你的真实值；只读账号用于 SQL 护栏的 dry-run 连接
DBA_MYSQL_DSN=mysql+asyncmy://dba_user:CHANGE_ME@192.168.200.10:3306/dba
DBA_MYSQL_RO_DSN=mysql+asyncmy://dba_readonly:CHANGE_ME@192.168.200.10:3306/dba
DBA_MONGO_DSN=mongodb://192.168.200.10:27017
DBA_MONGO_DB=dba
DBA_REDIS_DSN=redis://:CHANGE_ME@192.168.200.10:6379/0

# ── Milvus（可降级）────────────────────────────────────
DBA_MILVUS_HOST=192.168.200.10
DBA_MILVUS_PORT=19530

# ── Elasticsearch（可降级）─────────────────────────────
DBA_ES_URL=http://192.168.200.10:9200
DBA_ES_INDEX_PREFIX=dba

# ── MinIO（可降级）─────────────────────────────────────
DBA_MINIO_ENDPOINT=192.168.200.10:9000
DBA_MINIO_ACCESS_KEY=minioadmin
DBA_MINIO_SECRET=CHANGE_ME
DBA_MINIO_SECURE=false

# ── 向量化服务（复用 VM 上已有的 8081，模型 bge-large-zh-v1.5）──
DBA_EMBEDDING_URL=http://192.168.200.10:8081
DBA_EMBEDDING_PATH=/v1/embeddings
DBA_EMBEDDING_DIM=1024
DBA_EMBEDDING_MODEL=bge-large-zh-v1.5

# ── 认证 ──────────────────────────────────────────────
DBA_JWT_SECRET=CHANGE_ME
DBA_JWT_ALG=HS256
DBA_ACCESS_TOKEN_TTL_S=3600
DBA_REFRESH_TOKEN_TTL_S=1209600

# ── 预算守卫护栏 ──────────────────────────────────────
DBA_GUARDRAIL_ENABLED=true
DBA_GUARDRAIL_ALLOW_DOWNGRADE=true
DBA_GUARDRAIL_ALLOW_COMPRESS=true
DBA_GUARDRAIL_ALLOW_RATE_LIMIT=true
DBA_GUARDRAIL_ALLOW_CIRCUIT_BREAK=false
DBA_GUARDRAIL_EXEMPTION_PRIORITY=50
DBA_GUARDRAIL_MAX_DOWNGRADES_PER_RUN=2
DBA_GUARDRAIL_KILL_SWITCH=false
DBA_GUARDRAIL_DEGRADE_POLICY=fail_open_mysql

# ── LLM（OpenAI 兼容协议；可换 Qwen/DeepSeek/GLM）──────
DBA_LLM_PROVIDER=openai
DBA_LLM_BASE_URL=
DBA_LLM_API_KEY=

# ── 服务 ──────────────────────────────────────────────
DBA_HOST=0.0.0.0
DBA_PORT=8000
DBA_LOG_LEVEL=INFO
